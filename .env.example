APP_ENV=production
RUST_LOG=info
FRONTEND_URL=https://velismail.online
PUBLIC_API_URL=https://api.velismail.online

# Service hosts/ports are supplied by deploy/native/install.sh as systemd
# Environment= values. Do not duplicate them here: EnvironmentFile values
# override the unit settings and break multi-instance gateway scaling.
# For local development the code defaults (127.0.0.1:300x) are used.

AUTH_SERVICE_URL=http://127.0.0.1:3001
MAIL_SERVICE_URL=http://127.0.0.1:3002
STORAGE_SERVICE_URL=http://127.0.0.1:3003
TENANT_SERVICE_URL=http://127.0.0.1:3004
DELIVERY_SERVICE_URL=http://127.0.0.1:3005
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
GATEWAY_MAX_BODY_MB=32
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REQUESTS=256
# Protects /metrics. Leave blank to disable the endpoint entirely.
METRICS_TOKEN=generate-a-long-random-token
# Allow RFC1918/loopback BYO database hosts (only for self-hosted databases).
ALLOW_PRIVATE_BUSINESS_DB=false

# Local PostgreSQL (installed natively or managed).
# POSTGRES_PASSWORD must be 16+ URL-safe characters (letters, digits, '_', '-')
# because it is embedded in DATABASE_URL without percent-encoding.
DATABASE_URL=postgresql://velismail:replace-with-strong-postgres-password@127.0.0.1:5432/velismail
POSTGRES_DB=velismail
POSTGRES_USER=velismail
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# External Redis (Upstash) or local Redis URL.
# Upstash requires TLS: use rediss://, not redis://.
REDIS_URL=rediss://default:replace-with-redis-password@host:6379

JWT_SECRET=generate-a-long-random-secret-at-least-64-chars
# Access-token lifetime. The dashboard rotates it with the refresh token.
JWT_EXPIRY_SECONDS=86400
REFRESH_TOKEN_EXPIRY_DAYS=30

OTP_SIGNING_SECRET=generate-a-long-random-secret
OTP_TTL_SECONDS=600

# Platform email (OTP, password reset, feedback, and the backend mail relay)
# is delivered through Resend. No SMTP relay is used.
PLATFORM_RESEND_API_KEY=re_your_platform_system_notification_key_here
PLATFORM_FROM_EMAIL=no-reply@velismail.online
PLATFORM_FROM_NAME=VelisMail
OTP_FROM_EMAIL=no-reply@velismail.online
OTP_FROM_NAME=VelisMail

BASE_DOMAIN=velismail.online
# VelisMail is BYO provider only. Users add their own provider API key and
# Resend webhook signing secret during Business Setup. The platform does not
# provide shared Resend/SendGrid/Postmark delivery credentials.
# Resend users should configure their account webhook endpoint as:
# https://api.velismail.online/api/v1/mail/inbound with event email.received.
# Optional central route store for domain -> user provider route mapping. Falls back to DATABASE_URL.
INBOUND_ROUTING_DB_URL=postgresql://velismail:replace-with-strong-postgres-password@127.0.0.1:5432/velismail
# Used by domain verification to confirm the exact Resend receiving webhook URL.

# The delivery queue is PostgreSQL-backed; no message broker is required.
QUEUE_CONCURRENCY=16
QUEUE_POLL_SECONDS=5
QUEUE_RETRY_MAX=5
QUEUE_RETRY_BACKOFF_SECS=60

# Local VM storage for encrypted attachments. Create and chown this directory
# to the service user before starting storage-service.
STORAGE_ROOT=/var/lib/velismail/storage

ENCRYPTION_KEY=generate-a-long-random-base64-key
MAX_FILE_SIZE_MB=50
DEFAULT_QUOTA_BYTES=5368709120
MAX_ATTACHMENT_SIZE_MB=25
UNDO_SEND_WINDOW=30

MAX_SESSIONS_PER_USER=5
REQUIRE_MFA=false
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPT_WINDOW_MINUTES=15

# Optional DKIM signing key. Leave empty to disable DKIM signing, or paste the
# COMPLETE PEM key in a single quoted value. A truncated key or an unbalanced
# quote here makes systemd swallow the following variables (see check-env.sh).
DKIM_PRIVATE_KEY=
# Publish the matching dkim-public.pem in DNS as TXT at:
# <DKIM_SELECTOR>._domainkey.yourdomain.com
DKIM_SELECTOR=velismail
# Resend uses Amazon SES for delivery. Publish:
# v=spf1 include:amazonses.com ~all
SPF_RECORD=v=spf1 include:amazonses.com ~all

# Payment gateway (Razorpay) - used for subscription billing
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret
DMARC_DOMAIN=velismail.online

# --- Firebase Google sign-in ---
# Public web API key used by the auth service to verify Google ID tokens.
FIREBASE_WEB_API_KEY=replace-with-firebase-web-api-key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# The app id is optional, but it is required when a Google account is used to
# sign in with the phone-number or multi-factor flows.
FIREBASE_APP_ID=
# Comma-separated verified Firebase UIDs allowed into the platform control
# plane (the "Control Plane" switch in the business dashboard).
# The UID is shown in the control plane when access is refused.
PLATFORM_OWNER_UIDS=
# Comma-separated email addresses allowed into the platform control plane as
# platform owner. A Firebase UID only exists after the very first verified
# sign-in, so owners are normally configured here instead. Either list grants
# ownership; everybody else needs an explicit invitation with a platform role.
PLATFORM_OWNER_EMAILS=

# --- Optional aliases and tuning ---
# The gateway accepts RESEND_API_KEY as an alias for PLATFORM_RESEND_API_KEY,
# FIREBASE_API_KEY as an alias for FIREBASE_WEB_API_KEY and SECURITY_SERVICE_URL
# as an alias for DELIVERY_SERVICE_URL.
# RESEND_API_KEY=
# FIREBASE_API_KEY=
# SECURITY_SERVICE_URL=http://127.0.0.1:3005
# Connection pool sizes. The defaults fit a single small instance.
# DB_MIN_CONNECTIONS=2
# DB_MAX_CONNECTIONS=20
# REDIS_MAX_CONNECTIONS=20


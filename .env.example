APP_ENV=production
RUST_LOG=info
FRONTEND_URL=https://velismail.online
VITE_API_URL=https://api.example.com

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=3000
RATE_LIMIT_PER_MINUTE=100
AUTH_SERVICE_URL=http://auth-service:3001
MAIL_SERVICE_URL=http://mail-service:3002
STORAGE_SERVICE_URL=http://storage-service:3003
TENANT_SERVICE_URL=http://tenant-service:3004
DELIVERY_SERVICE_URL=http://delivery-engine:3005

POSTGRES_DB=velismail
POSTGRES_USER=velismail
POSTGRES_PASSWORD=change-this-postgres-password
AUTH_POSTGRES_DB=velismail_auth
MAIL_POSTGRES_DB=velismail_mail
STORAGE_POSTGRES_DB=velismail_storage
TENANT_POSTGRES_DB=velismail_tenant
DELIVERY_POSTGRES_DB=velismail_delivery

REDIS_PASSWORD=change-this-redis-password

JWT_SECRET=generate-a-long-random-secret-at-least-64-chars
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30

OTP_SIGNING_SECRET=generate-a-long-random-secret
OTP_TTL_SECONDS=600
OTP_FROM_EMAIL=no-reply@example.com
OTP_FROM_NAME=VelisMail

PASSKEY_RELYING_PARTY=mail.example.com
PASSKEY_ORIGIN=https://mail.example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=your-smtp-password
# OTP delivery uses the SMTP credentials above. Per-user mail provider API keys
# (Brevo / SendGrid / Resend / Postmark / custom webhook) are entered inside the app.

# Platform-level Resend API key for sending mail from the official domain.
# When set, users sending from @velismail.online will use this key automatically,
# so they don't need to verify the platform domain in their own Resend accounts.
BASE_DOMAIN=velismail.online
PLATFORM_RESEND_API_KEY=re_your_platform_resend_api_key_here

NATS_URL=nats://nats:4222
NATS_CREDS=

S3_ENDPOINT=
S3_BUCKET=velismail
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

ENCRYPTION_KEY=generate-a-long-random-base64-key
MAX_FILE_SIZE_MB=50
MAX_ATTACHMENT_SIZE_MB=25
EMAILS_PER_PAGE=50
UNDO_SEND_WINDOW=30

MAX_SESSIONS_PER_USER=5
AUTH_RATE_LIMIT_PER_MINUTE=60
REQUIRE_MFA=false
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPT_WINDOW_MINUTES=15

DKIM_PRIVATE_KEY=
# Publish the matching dkim-public.pem in DNS as TXT at:
# <DKIM_SELECTOR>._domainkey.yourdomain.com
DKIM_SELECTOR=velismail
SPF_RECORD=

# Payment gateway (Razorpay) — used for subscription billing
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Root .env example
# Primary deploy target is Vercel for the frontend and Cloudflare Workers for the backend.
# Copy values into a real .env only for local experiments. Do NOT commit real secrets.

# Frontend / Worker
VITE_API_URL=https://api.velismail.online
FRONTEND_ORIGIN=https://velismail.online,https://www.velismail.online
BREVO_API_KEY=<YOUR_BREVO_API_KEY>
BREVO_SENDER_NAME=VelisMail
OTP_SIGNING_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>
OTP_TTL_SECONDS=600
PRIMARY_MAIL_DOMAIN=velismail.online
MAIL_FROM_EMAIL=noreply@velismail.online
MAIL_FROM_NAME=VelisMail
OTP_FROM_EMAIL=verify@velismail.online
OTP_FROM_EMAIL_LOCAL_PART=verify
ALLOWED_SENDER_DOMAINS=velismail.online

# Optional legacy local Rust values
RUST_LOG=info
DATABASE_URL=<YOUR_DATABASE_URL>
REDIS_URL=<YOUR_REDIS_URL>
NATS_URL=<YOUR_NATS_URL>
PASSKEY_RELYING_PARTY=velismail.online
PASSKEY_ORIGIN=https://velismail.online

# Postgres defaults used by docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=velismail

# Redis defaults
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO (S3) defaults
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

APP_ENV=production
RUST_LOG=info
FRONTEND_URL=https://velismail.online
VITE_API_URL=https://api.velismail.online

GATEWAY_HOST=0.0.0.0
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=3000
RATE_LIMIT_PER_MINUTE=100
AUTH_SERVICE_URL=http://auth-service:3001
MAIL_SERVICE_URL=http://mail-service:3002
STORAGE_SERVICE_URL=http://storage-service:3003
TENANT_SERVICE_URL=http://tenant-service:3004
DELIVERY_SERVICE_URL=http://delivery-engine:3005

POSTGRES_DB=velismail
POSTGRES_USER=velismail
POSTGRES_PASSWORD=replace-with-strong-postgres-password
AUTH_POSTGRES_DB=velismail_auth
MAIL_POSTGRES_DB=velismail_mail
STORAGE_POSTGRES_DB=velismail_storage
TENANT_POSTGRES_DB=velismail_tenant
DELIVERY_POSTGRES_DB=velismail_delivery

REDIS_PASSWORD=replace-with-strong-redis-password

JWT_SECRET=generate-a-long-random-secret-at-least-64-chars
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30

OTP_SIGNING_SECRET=generate-a-long-random-secret
OTP_TTL_SECONDS=600
OTP_FROM_EMAIL=no-reply@velismail.online
OTP_FROM_NAME=VelisMail


SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@velismail.online
SMTP_PASSWORD=your-smtp-password
# Platform/system notifications use PLATFORM_RESEND_API_KEY when set, otherwise
# they fall back to the SMTP credentials above. This key is only for login OTP,
# password reset OTP, and team-invite verification emails. User business mail
# remains BYO and never uses this platform key.
PLATFORM_RESEND_API_KEY=re_your_platform_system_notification_key_here

BASE_DOMAIN=velismail.online
# VelisMail is BYO provider only. Users add their own provider API key and
# Resend webhook signing secret during Business Setup. The platform does not
# provide shared Resend/SendGrid/Brevo/Postmark delivery credentials.
# Resend users should configure their account webhook endpoint as:
# https://api.velismail.online/api/v1/mail/inbound with event email.received.
# Optional central route store for domain -> user provider route mapping. Falls back to DATABASE_URL.
INBOUND_ROUTING_DB_URL=
# Used by domain verification to confirm the exact Resend receiving webhook URL.
PUBLIC_API_URL=https://api.velismail.online

NATS_URL=nats://nats:4222
NATS_CREDS=

S3_ENDPOINT=
S3_BUCKET=velismail
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

ENCRYPTION_KEY=generate-a-long-random-base64-key
MAX_FILE_SIZE_MB=50
MAX_ATTACHMENT_SIZE_MB=25
UNDO_SEND_WINDOW=30

MAX_SESSIONS_PER_USER=5
AUTH_RATE_LIMIT_PER_MINUTE=60
REQUIRE_MFA=false
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPT_WINDOW_MINUTES=15

DKIM_PRIVATE_KEY=
# Publish the matching dkim-public.pem in DNS as TXT at:
# <DKIM_SELECTOR>._domainkey.yourdomain.com
DKIM_SELECTOR=velismail
SPF_RECORD=

# Payment gateway (Razorpay) - used for subscription billing
RAZORPAY_KEY_ID=rzp_live_replace_with_key_id
RAZORPAY_KEY_SECRET=your-razorpay-secret
VITE_RAZORPAY_KEY_ID=rzp_live_replace_with_key_id

# Common
RUST_LOG=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/velismail
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# API gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
MAIL_SERVICE_URL=http://localhost:3002
STORAGE_SERVICE_URL=http://localhost:3003
TENANT_SERVICE_URL=http://localhost:3004
DELIVERY_SERVICE_URL=http://localhost:3005

# Auth
AUTH_HOST=0.0.0.0
AUTH_PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30
MAX_SESSIONS_PER_USER=5

# Mail
MAIL_HOST=0.0.0.0
MAIL_PORT=3002
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Storage
STORAGE_HOST=0.0.0.0
STORAGE_PORT=3003
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=velismail

# Tenant
TENANT_HOST=0.0.0.0
TENANT_PORT=3004

# Delivery
DELIVERY_HOST=0.0.0.0
DELIVERY_PORT=3005
DKIM_SELECTOR=velismail
DKIM_PRIVATE_KEY=


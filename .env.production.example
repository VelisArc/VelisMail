# VelisMail Backend .env.production (VM DEPLOYMENT)
# Yeh file aapke VM me `/path/to/velismail/.env.production` ke roop me honi chahiye.

# ==========================================
# 1. POSTGRES DATABASE SETTINGS
# ==========================================
# Database ka naam aur user aap wahi rehne de sakte hain,
# lekin POSTGRES_PASSWORD me ek strong password dalein.
POSTGRES_DB=velismail
POSTGRES_USER=velismail
POSTGRES_PASSWORD=<YEAH_PAR_APNA_STRONG_DB_PASSWORD_DALO>

# ==========================================
# 2. REDIS SETTINGS
# ==========================================
# Redis cache ka password yahan set karein.
REDIS_PASSWORD=<YEAH_PAR_APNA_STRONG_REDIS_PASSWORD_DALO>

# ==========================================
# 3. JWT & AUTHENTICATION SECRETS
# ==========================================
# API authentication ke liye secret key. Ise bilkul random aur lamba rakhein (64+ chars).
JWT_SECRET=<YEAH_PAR_APNA_LONG_RANDOM_SECRET_DALO>
# Kitne seconds me token expire hoga (3600 = 1 hour)
JWT_EXPIRY_SECONDS=3600
# Refresh token kitne din chalega
REFRESH_TOKEN_EXPIRY_DAYS=30

# Aapke domain ka naam jahan frontend hosted hai (e.g. velismail.online)
PASSKEY_RELYING_PARTY=velismail.online
PASSKEY_ORIGIN=https://velismail.online

# ==========================================
# 4. API GATEWAY SETTINGS
# ==========================================
# API ko kitni requests per minute allow karni hai
RATE_LIMIT_PER_MINUTE=100
# Yeh port hai jisme API VM ke bahar expose hogi (Cloudflare/Nginx ke peeche 3000 thik hai)
GATEWAY_PORT=3000
GATEWAY_BIND=127.0.0.1

# ==========================================
# 5. SMTP/MAIL SETTINGS (Emails bhejne ke liye)
# ==========================================
# Apna SMTP provider details dalein (jaise AWS SES, Brevo, SendGrid etc.)
SMTP_HOST=<YEAH_PAR_SMTP_HOST_DALO>
SMTP_PORT=587
SMTP_USERNAME=<YEAH_PAR_SMTP_USERNAME_DALO>
SMTP_PASSWORD=<YEAH_PAR_SMTP_PASSWORD_DALO>

# ==========================================
# 6. S3 STORAGE SETTINGS (Optional - Attachments ke liye)
# ==========================================
# Agar aap AWS S3 ya MinIO use kar rahe hain toh yahan keys dalein.
# S3_ENDPOINT=<YEAH_PAR_S3_ENDPOINT_DALO>
# S3_BUCKET=velismail
# S3_ACCESS_KEY=<YEAH_PAR_S3_ACCESS_KEY_DALO>
# S3_SECRET_KEY=<YEAH_PAR_S3_SECRET_KEY_DALO>
# S3_REGION=auto

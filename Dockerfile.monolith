FROM rust:1.91.1-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates build-essential curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY libs ./libs
COPY services ./services

RUN cargo build --release --bin velismail-monolith

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -u 10001 -m appuser

WORKDIR /app
COPY --from=builder /src/target/release/velismail-monolith /app/velismail-monolith

USER appuser
EXPOSE 3000
CMD ["/app/velismail-monolith"]

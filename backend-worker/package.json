{
  "name": "velismail-api-worker",
  "private": true,
  "version": "5.3.0",
  "description": "VelisMail backend on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute velismail-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute velismail-db --remote --file=./schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}

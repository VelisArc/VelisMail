### Auth Service (.env.example)

AUTH_HOST=0.0.0.0
AUTH_PORT=3001
DATABASE_URL=postgres://postgres:postgres@postgres:5432/velismail_auth
REDIS_URL=redis://redis:6379

# Security and tokens
JWT_SECRET=change-me-in-production
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30

# Rate limiting / sessions
AUTH_RATE_LIMIT_PER_MINUTE=60
MAX_SESSIONS_PER_USER=5
REQUIRE_MFA=false

# WebAuthn / Passkey defaults
PASSKEY_RELYING_PARTY=velismail.online
PASSKEY_ORIGIN=https://velismail.online

# Lockout / brute-force settings
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
FAILED_ATTEMPT_WINDOW_MINUTES=15

### Delivery Engine (.env.example)

DELIVERY_HOST=0.0.0.0
DELIVERY_PORT=3005
PORT=3005
DATABASE_URL=postgres://postgres:postgres@postgres:5432/velismail_delivery
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
NATS_CREDS=

DKIM_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
DKIM_SELECTOR=velismail
SPF_RECORD=v=spf1 include:velismail.online ~all

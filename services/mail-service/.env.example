### Mail Service (.env.example)

MAIL_HOST=0.0.0.0
MAIL_PORT=3002
PORT=3002
DATABASE_URL=postgres://postgres:postgres@postgres:5432/velismail_mail
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
NATS_CREDS=

# SMTP / relay settings
SMTP_HOST=smtp.velismail.online
SMTP_PORT=587
SMTP_USERNAME=noreply@velismail.online
SMTP_PASSWORD=change-me

# Limits and paging
MAX_ATTACHMENT_SIZE_MB=25
UNDO_SEND_WINDOW=30
EMAILS_PER_PAGE=50

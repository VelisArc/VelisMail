### Storage Service (.env.example)

STORAGE_HOST=0.0.0.0
STORAGE_PORT=3003
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=velismail

DATABASE_URL=postgres://postgres:postgres@postgres:5432/velismail_storage
REDIS_URL=redis://redis:6379

MAX_FILE_SIZE_MB=50
ENCRYPTION_KEY=change-me-32-bytes-key
